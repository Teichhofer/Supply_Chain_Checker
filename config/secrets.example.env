# Secrets für Supply Chain Checker
# Nutzung:
#   cp config/secrets.example.env config/secrets.env
#   source config/secrets.env

# OpenAI API-Key für LLM-Aufrufe
export OPENAI_API_KEY="<dein_openai_api_key>"

# Optional: Eigene OpenAI-kompatible Base URL (falls später unterstützt)
# export OPENAI_BASE_URL="https://api.openai.com/v1"

# Platz für weitere projektspezifische Geheimnisse
# export SUPPLY_CHAIN_WEBHOOK_TOKEN="<dein_token>"
